# Template. Real values live in ../local/.env, which is gitignored.

# sslmode=require is mandatory — the Cloud SQL instance is ENCRYPTED_ONLY.
POSTGRES_URL=postgresql://user:password@host:5432/searchagent?sslmode=require

# dash-dev, NOT api.staple.io — see SPEC §16.
STAPLE_GRAPHQL_URL=https://dash-dev.staple.io/graphql

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=

FUZZY_THRESHOLD=0.85
API_HOST=0.0.0.0
API_PORT=8001

# ── LangSmith tracing ────────────────────────────────────────────────────────
# WORKSPACE_ID is required for org-scoped (lsv2_sk_) keys — without it trace
# ingestion 403s silently and runs never appear.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=compass
